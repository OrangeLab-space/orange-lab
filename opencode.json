{
    "$schema": "https://opencode.ai/config.json",
    "permissions": [
        { "action": "external_directory", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "awk *", "effect": "allow" },
        { "action": "shell", "resource": "cat *", "effect": "allow" },
        { "action": "shell", "resource": "curl *", "effect": "allow" },
        { "action": "shell", "resource": "date *", "effect": "allow" },
        { "action": "shell", "resource": "dig *", "effect": "allow" },
        { "action": "shell", "resource": "echo *", "effect": "allow" },
        { "action": "shell", "resource": "find *", "effect": "allow" },
        { "action": "shell", "resource": "git blame *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git fetch *", "effect": "allow" },
        { "action": "shell", "resource": "git grep *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git show *", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "gh * diff *", "effect": "allow" },
        { "action": "shell", "resource": "gh * list *", "effect": "allow" },
        { "action": "shell", "resource": "gh * view *", "effect": "allow" },
        { "action": "shell", "resource": "gh search *", "effect": "allow" },
        { "action": "shell", "resource": "grep *", "effect": "allow" },
        { "action": "shell", "resource": "head *", "effect": "allow" },
        { "action": "shell", "resource": "helm list *", "effect": "allow" },
        { "action": "shell", "resource": "jq *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl -n * describe *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl -n * get *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl -n * logs *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl describe *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl get *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl logs *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl rollout status *", "effect": "allow" },
        { "action": "shell", "resource": "ls *", "effect": "allow" },
        { "action": "shell", "resource": "nl", "effect": "allow" },
        { "action": "shell", "resource": "npm audit *", "effect": "allow" },
        { "action": "shell", "resource": "npm ls *", "effect": "allow" },
        { "action": "shell", "resource": "npm outdated *", "effect": "allow" },
        { "action": "shell", "resource": "npm view *", "effect": "allow" },
        { "action": "shell", "resource": "npm run build *", "effect": "allow" },
        { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
        { "action": "shell", "resource": "npm run test *", "effect": "allow" },
        { "action": "shell", "resource": "npm test*", "effect": "allow" },
        { "action": "shell", "resource": "npx prettier *", "effect": "allow" },
        { "action": "shell", "resource": "printf *", "effect": "allow" },
        { "action": "shell", "resource": "pulumi config get *", "effect": "allow" },
        { "action": "shell", "resource": "pulumi preview *", "effect": "allow" },
        { "action": "shell", "resource": "pulumi stack ls *", "effect": "allow" },
        { "action": "shell", "resource": "pulumi stack output *", "effect": "allow" },
        { "action": "shell", "resource": "pwd", "effect": "allow" },
        { "action": "shell", "resource": "rg *", "effect": "allow" },
        { "action": "shell", "resource": "sed *", "effect": "allow" },
        { "action": "shell", "resource": "sleep *", "effect": "allow" },
        { "action": "shell", "resource": "sort *", "effect": "allow" },
        { "action": "shell", "resource": "tail *", "effect": "allow" },
        { "action": "shell", "resource": "tr *", "effect": "allow" },
        { "action": "shell", "resource": "uniq *", "effect": "allow" },
        { "action": "shell", "resource": "wc *", "effect": "allow" },
        { "action": "shell", "resource": "kubectl apply *", "effect": "ask" },
        { "action": "shell", "resource": "kubectl delete *", "effect": "ask" },
        { "action": "shell", "resource": "kubectl exec *", "effect": "ask" },
        { "action": "shell", "resource": "kubectl get secret *", "effect": "ask" },
        { "action": "shell", "resource": "kubectl get secrets *", "effect": "ask" },
        { "action": "shell", "resource": "kubectl -n * get secret *", "effect": "ask" },
        { "action": "shell", "resource": "kubectl rollout restart *", "effect": "ask" },
        { "action": "shell", "resource": "*Pulumi.*.yaml*", "effect": "ask" },
        { "action": "shell", "resource": "pulumi * --show-secrets *", "effect": "ask" },
        { "action": "read", "resource": "*Pulumi.yaml", "effect": "allow" },
        { "action": "edit", "resource": "*Pulumi.yaml", "effect": "allow" },
        { "action": "read", "resource": "*Pulumi.*.yaml*", "effect": "deny" },
        { "action": "edit", "resource": "*Pulumi.*.yaml*", "effect": "deny" },
        { "action": "edit", "resource": "*node_modules*", "effect": "deny" }
    ]
}
