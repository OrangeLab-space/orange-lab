{
    "$schema": "https://opencode.ai/config.json",
    "permission": {
        "bash": {
            "*": "ask",
            "*Pulumi*.yaml*": "ask",
            "cat *": "allow",
            "curl *": "allow",
            "echo *": "allow",
            "find *": "allow",
            "gh release *": "ask",
            "git diff *": "allow",
            "git fetch *": "allow",
            "git log *": "allow",
            "git show *": "allow",
            "git status *": "allow",
            "gh issue list *": "allow",
            "gh pr list *": "allow",
            "gh pr diff *": "allow",
            "gh repo list *": "allow",
            "gh search issues *": "allow",
            "grep *": "allow",
            "head *": "allow",
            "jq *": "allow",
            "kubectl describe *": "allow",
            "kubectl get *": "allow",
            "kubectl -n * get *": "allow",
            "kubectl -n * describe *": "allow",
            "kubectl -n * logs *": "allow",
            "kubectl rollout status *": "allow",
            "kubectl apply *": "ask",
            "kubectl delete *": "ask",
            "kubectl exec *": "ask",
            "kubectl rollout restart *": "ask",
            "kubectl get secret *": "ask",
            "kubectl get secrets *": "ask",
            "kubectl logs *": "allow",
            "ls *": "allow",
            "npm run build *": "allow",
            "npm run lint": "allow",
            "npm run test": "allow",
            "npm test*": "allow",
            "pulumi * --show-secrets *": "ask",
            "pulumi config get *": "allow",
            "pulumi config set *": "ask",
            "pulumi preview *": "allow",
            "pulumi up *": "ask",
            "pulumi destroy *": "ask",
            "pulumi stack output *": "allow",
            "pwd": "allow",
            "rg *": "allow",
            "sed *": "allow",
            "sort *": "allow",
            "sleep *": "allow",
            "tail *": "allow",
            "tr *": "allow",
            "uniq *": "allow",
            "wc *": "allow"
        },
        "read": {
            "**/Pulumi.*.yaml": "deny"
        },
        "edit": {
            "*": "ask",
            "**/Pulumi.*.yaml": "deny",
            "node_modules/*": "deny"
        }
    }
}
