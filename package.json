{
    "name": "orange-lab",
    "description": "Private distributed self-hosting infrastructure",
    "version": "0.8.0",
    "private": true,
    "main": "index.ts",
    "license": "MIT",
    "workspaces": [
        "packages/*",
        "stacks/*"
    ],
    "engines": {
        "node": ">= 22.0.0"
    },
    "scripts": {
        "build": "npm run build -w @orangelab/pulumi",
        "deploy": "pulumi up",
        "lint": "node_modules/.bin/eslint .",
        "preview": "pulumi preview --diff",
        "test": "npx tsc --noEmit && npm run lint",
        "release": "bash scripts/orangelab-release.sh",
        "publish": "bash scripts/orangelab-publish.sh"
    },
    "dependencies": {
        "@orangelab/pulumi": "*",
        "@pulumi/kubernetes": "4.34.2",
        "@pulumi/pulumi": "3.270.0",
        "@pulumi/random": "4.21.4",
        "bcryptjs": "3.0.3"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@pulumi/eslint-plugin": "0.3.1",
        "@types/node": "26.6.5",
        "eslint": "10.13.0",
        "globals": "17.13.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0"
    }
}
